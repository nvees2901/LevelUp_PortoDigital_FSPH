# Gemini (desativado temporariamente - quota esgotada)
# GEMINI_API_KEY=AIzaSyBx-xUp-Sj4B6mWGHbS-MaBeWTXoltRZuE
GEMINI_MODEL=gemini-2.0-flash

# Database (PostgreSQL local via Homebrew, porta padrão 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fsph

# Ollama (IA local) — ATIVO (provider confiável; tem prioridade sobre OpenRouter)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter — opcional. Cole sua chave (https://openrouter.ai/keys) e
# comente OLLAMA_BASE_URL acima para usar o OpenRouter como provedor primário.
# (Deixada em branco — repositório público; não versionar segredos.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# RAG (ChromaDB) — desativado (ChromaDB roda via Docker)
RAG_ENABLED=false

# Timeout das chamadas de IA (modelo local qwen2.5:3b é lento em prompts longos)
AI_TIMEOUT_SECONDS=300

# JWT — em produção substitua SECRET_KEY por:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
