# Backend production environment example
# Copy this file to backend/.env.production and replace values before deploying.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fsph
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ENVIRONMENT=production
DEBUG=false
RAG_ENABLED=false
OLLAMA_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GCS_BUCKET=
GCS_UPLOAD_PREFIX=uploads
GCS_CONTEXT_DOCS_PREFIX=context_documents
